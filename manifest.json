{
  "name": "Iconx",
  "short_name": "Iconx",

  "categories": [
    "productivity",
    "utilities",
    "games",
    "education",
    "photo",
    "entertainment"
  ],
  "description": "Icon display size testing across different devices, screen sizes, and browsers.",

  "scope": "/",
  "id": "/?homescreen=1",
  "start_url": "/?homescreen=1",

  "theme_color": "#11111b",
  "background_color": "#11111b",

  "display": "fullscreen",
  "display_override": ["window-controls-overlay"],
  "prefer_related_applications": false,

  "protocol_handlers": [
    {
      "protocol": "web+myapp",
      "url": "/?url=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "icons": [
    {
      "src": "./public/icons/logo-x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "src": "./public/icons/logo-x192-1.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./public/icons/splash-x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "purpose": "maskable",
      "src": "./public/icons/splash-x512-1.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],

  "screenshots": [
    {
      "sizes": "750x1334",
      "src": "./public/images/screenshots-mobile.png",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "sizes": "1920x1080",
      "src": "./public/images/screenshots-desktop.png",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],

  "shortcuts": [
    {
      "name": "New Chat",
      "url": "/?action=open",
      "icons": [
        {
          "src": "./public/icons/logo-x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings",
      "url": "/?action=settings",
      "icons": [
        {
          "src": "./public/icons/logo-x192-1.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",

    "params": {
      "title": "title",
      "text": "text",
      "url": "url",

      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            "text/markdown",
            "text/html",
            "text/css",
            "text/javascript"
          ]
        }
      ]
    }
  },

  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt", ".md", ".html", ".css", ".js"],
        "text/markdown": [".md"]
      }
    }
  ]
}
