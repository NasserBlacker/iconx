// see https://developer.mozilla.org/en-US/docs/Web/Progressive_web_apps/Manifest/Reference/theme_color
{
  "name": "Iconx",
  "short_name": "Iconx",
  "description": "Icon display size testing across different devices, screen sizes, and browsers.",

  "categories": [
    "productivity",
    "utilities",
    "games",
    "education",
    "photo",
    "entertainment"
  ],

  "scope": "/",
  "lang": "en",
  "id": "/?homescreen=1",
  "start_url": "/?homescreen=1",

  "theme_color": "#e9ecef",
  "background_color": "#e9ecef",

  // see https://developer.mozilla.org/en-US/docs/Web/Progressive_web_apps/Manifest/Reference/display
  "display": "standalone",

  // see https://learn.microsoft.com/en-us/microsoft-edge/progressive-web-apps/how-to/window-controls-overlay
  "display_override": ["standalone", "fullscreen", "minimal-ui", "browser"],
  "prefer_related_applications": false,

  "orientation": "any",

  "protocol_handlers": [
    {
      "protocol": "web+myapp",
      "url": "/?url=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "icons": [
    {
      "src": "./public/icons/logo-x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "src": "./public/icons/logo-x192-1.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./public/icons/splash-x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "purpose": "maskable",
      "src": "./public/icons/splash-x512-1.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],

  "screenshots": [
    {
      "sizes": "750x1334",
      "src": "./public/images/screenshots-mobile.png",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "sizes": "1920x1080",
      "src": "./public/images/screenshots-desktop.png",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],

  "shortcuts": [
    {
      "name": "New Chat",
      "url": "/?action=open",
      "icons": [
        {
          "src": "./public/icons/logo-x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings",
      "url": "/?action=settings",
      "icons": [
        {
          "src": "./public/icons/logo-x192-1.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",

    "params": {
      "title": "title",
      "text": "text",
      "url": "url",

      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            "text/markdown",
            "text/html",
            "text/css",
            "text/javascript"
          ]
        }
      ]
    }
  },

  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/css": [".css"],
        "text/html": [".html"],
        "text/javascript": [".js"],
        "text/markdown": [".md"],
        "text/plain": [".txt"]
      }
    }
  ]
}
